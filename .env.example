# EMI Calculator QA Automation - Environment Configuration
# RULE: Never commit passwords, secrets, or API keys to version control
# RULE: Load all sensitive data from environment variables or .env (gitignored)
# 
# SETUP:
# 1. Copy this file: cp .env.example .env
# 2. Update values for your environment
# 3. Add .env to .gitignore (already done)
# 4. In CI/CD: Use platform-specific secrets management (GitHub Secrets, etc.)

# ==========================================
# Application Configuration
# ==========================================

# Application URL to test against
APP_URL=https://emicalculator.net
BASE_URL=https://emicalculator.net

# ==========================================
# API Configuration (if using API testing)
# ==========================================

# API Base URL for backend testing
API_BASE_URL=https://api.emicalculator.net

# API request timeout (milliseconds)
API_TIMEOUT=30000

# ==========================================
# Authentication (if required)
# ==========================================

# Username for login (if authentication required)
# NEVER commit actual credentials to git
AUTH_USERNAME=your_username_here

# Password for login (if authentication required)
# NEVER commit actual credentials to git
AUTH_PASSWORD=your_password_here

# API Key (if using API authentication)
# NEVER commit actual credentials to git
API_KEY=your_api_key_here

# Auth token (if using token authentication)
# NEVER commit actual credentials to git
AUTH_TOKEN=your_auth_token_here

# ==========================================
# Test Configuration
# ==========================================

# Run tests in headless mode (true/false)
# Default: true (no browser window)
HEADLESS=true

# Slow down test execution (milliseconds between actions)
# 0 = normal speed, 500 = very slow (useful for debugging)
SLOW_MO=0

# Number of parallel workers for test execution
WORKERS=2

# Number of retries for failed tests
RETRIES=1

# Test timeout per test (milliseconds)
TEST_TIMEOUT=60000

# ==========================================
# Storage and Session Configuration
# ==========================================

# Path to auth storage file (for login persistence)
# Format: .auth/user.json
AUTH_STORAGE_FILE=.auth/user.json

# ==========================================
# Debugging and Logging
# ==========================================

# Enable debug mode
DEBUG=false

# Verbose logging
VERBOSE=false

# Capture traces on test failure
TRACES=true

# ==========================================
# CI/CD Configuration
# ==========================================

# Set to "true" in CI environment
CI=false

# CI Provider (github, gitlab, jenkins, etc.)
CI_PROVIDER=github

# ==========================================
# Example for GitHub Actions
# ==========================================
# In GitHub Actions, use Secrets:
#   Settings → Secrets and variables → Actions → New repository secret
#
# Then reference in workflow:
#   APP_URL: ${{ secrets.APP_URL }}
#   AUTH_USERNAME: ${{ secrets.AUTH_USERNAME }}
#   AUTH_PASSWORD: ${{ secrets.AUTH_PASSWORD }}
#
# .env file is NOT used in CI - only environment variables

# ==========================================
# IMPORTANT SECURITY NOTES
# ==========================================
# ✅ DO:
# - Store sensitive data in environment variables
# - Use .gitignore to exclude .env from git
# - Use platform secrets in CI/CD (GitHub Secrets, GitLab CI/CD Variables, etc.)
# - Rotate credentials regularly
# - Use least-privilege accounts for automation
#
# ❌ DON'T:
# - Commit .env file to git
# - Hardcode passwords or tokens in code
# - Share credentials in pull request descriptions
# - Use production credentials in test automation
# - Log sensitive values to console
